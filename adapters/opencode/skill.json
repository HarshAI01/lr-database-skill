{
  "name": "lr-database",
  "version": "0.1.0",
  "description": "Literature Review Database Pipeline — Full SOP automation for OpenCode. Works with any OpenCode model.",
  "author": "Your Name",
  "license": "MIT",
  "opencode": { "version": ">=0.5.0" },
  "tools": [
    "lr-batch", "lr-ingest", "lr-dedup", "lr-extract-pdfs",
    "lr-assemble", "lr-verify", "lr-log"
  ],
  "workflows": ["lr-full-pipeline"],
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "projectRoot": { "type": "string", "description": "Project root folder", "default": "." },
        "scope": { "type": "string", "description": "Screening scope (optional)", "default": "" },
        "pythonPath": { "type": "string", "description": "Python executable", "default": "python" }
      },
      "required": ["projectRoot"]
    }
  }
}