{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LR Database Metadata Record (87 columns)",
  "type": "object",
  "description": "Zotero-compatible metadata record per SOP §5A. Order matters — must match Excel column order exactly.",
  "properties": {
    "File Name": { "type": "string", "description": "Exact filename in Database/ folder" },
    "Item Type": { "type": "string", "enum": ["journalArticle", "report", "preprint", "conferencePaper", "thesis"], "description": "ArXiv-only = preprint; IEEE no venue = conferencePaper if venue printed else preprint" },
    "Publication Year": { "type": "string", "description": "Year as printed (year, year-month, or full date). If PDF contradicts filename, use PDF and log." },
    "Author": { "type": "string", "description": "Full names in printed order, Last-name-comma-rest, semicolon-joined. E.g., \"Sharma, Pankaj; Patnaik, Tirthankar\". Corporate = org name. Single-token names as-is." },
    "Title": { "type": "string", "description": "Exact title as printed (keep ?, :, en-dash). Max ~180 chars for filename but full in field." },
    "Publication Title": { "type": "string", "description": "Journal/book/conference name as printed" },
    "ISBN": { "type": "string", "description": "Bare numbers only" },
    "ISSN": { "type": "string", "description": "Bare numbers only" },
    "DOI": { "type": "string", "description": "Bare form starting with 10. (strip https://doi.org/ or dx.doi.org/)" },
    "Url": { "type": "string", "description": "Only if printed in PDF" },
    "Abstract Note": { "type": "string", "description": "Verbatim Abstract section, ~1200 chars max" },
    "Date": { "type": "string", "description": "Year alone, year-month, or full date as printed" },
    "Date Added": { "type": "string", "format": "date-time", "description": "ISO timestamp when added to database" },
    "Date Modified": { "type": "string", "format": "date-time", "description": "ISO timestamp of last modification" },
    "Access Date": { "type": "string", "format": "date", "description": "Date accessed (YYYY-MM-DD)" },
    "Pages": { "type": "string", "description": "Page range as printed (e.g., \"129–151\")" },
    "Num Pages": { "type": "integer", "description": "Total page count" },
    "Issue": { "type": "string", "description": "Issue number" },
    "Volume": { "type": "string", "description": "Volume number" },
    "Number Of Volumes": { "type": "integer", "default": 1 },
    "Journal Abbreviation": { "type": "string", "description": "Standard abbreviation if known" },
    "Short Title": { "type": "string", "description": "Shortened title for citations" },
    "Series": { "type": "string" },
    "Series Number": { "type": "string" },
    "Series Text": { "type": "string" },
    "Series Title": { "type": "string" },
    "Publisher": { "type": "string", "description": "Publisher name as printed" },
    "Place": { "type": "string", "description": "Publication place" },
    "Language": { "type": "string", "default": "en" },
    "Rights": { "type": "string" },
    "Type": { "type": "string" },
    "Archive": { "type": "string" },
    "Archive Location": { "type": "string" },
    "Library Catalog": { "type": "string" },
    "Call Number": { "type": "string" },
    "Extra": { "type": "string", "description": "Additional metadata (e.g., eBook ISBN, edition info)" },
    "Notes": { "type": "string" },
    "File Attachments": { "type": "string", "description": "Database/ path + exact filename (root-relative)" },
    "Link Attachments": { "type": "string" },
    "Manual Tags": { "type": "string" },
    "Automatic Tags": { "type": "string" },
    "Editor": { "type": "string" },
    "Series Editor": { "type": "string" },
    "Translator": { "type": "string" },
    "Contributor": { "type": "string" },
    "Attorney Agent": { "type": "string" },
    "Book Author": { "type": "string" },
    "Cast Member": { "type": "string" },
    "Commenter": { "type": "string" },
    "Composer": { "type": "string" },
    "Cosponsor": { "type": "string" },
    "Counsel": { "type": "string" },
    "Interviewer": { "type": "string" },
    "Producer": { "type": "string" },
    "Recipient": { "type": "string" },
    "Reviewed Author": { "type": "string" },
    "Scriptwriter": { "type": "string" },
    "Words By": { "type": "string" },
    "Guest": { "type": "string" },
    "Number": { "type": "string" },
    "Edition": { "type": "string" },
    "Running Time": { "type": "string" },
    "Scale": { "type": "string" },
    "Medium": { "type": "string" },
    "Artwork Size": { "type": "string" },
    "Filing Date": { "type": "string" },
    "Application Number": { "type": "string" },
    "Assignee": { "type": "string" },
    "Issuing Authority": { "type": "string" },
    "Country": { "type": "string" },
    "Meeting Name": { "type": "string" },
    "Conference Name": { "type": "string" },
    "Court": { "type": "string" },
    "References": { "type": "string" },
    "Reporter": { "type": "string" },
    "Legal Status": { "type": "string" },
    "Priority Numbers": { "type": "string" },
    "Programming Language": { "type": "string" },
    "Version": { "type": "string" },
    "System": { "type": "string" },
    "Code": { "type": "string" },
    "Code Number": { "type": "string" },
    "Section": { "type": "string" },
    "Session": { "type": "string" },
    "Committee": { "type": "string" },
    "History": { "type": "string" },
    "Legislative Body": { "type": "string" }
  },
  "required": [
    "File Name", "Item Type", "Publication Year", "Author", "Title",
    "Publication Title", "ISBN", "ISSN", "DOI", "Url", "Abstract Note",
    "Date", "Date Added", "Date Modified", "Access Date", "Pages",
    "Num Pages", "Issue", "Volume", "Number Of Volumes", "Journal Abbreviation",
    "Short Title", "Series", "Series Number", "Series Text", "Series Title",
    "Publisher", "Place", "Language", "Rights", "Type", "Archive",
    "Archive Location", "Library Catalog", "Call Number", "Extra", "Notes",
    "File Attachments", "Link Attachments", "Manual Tags", "Automatic Tags",
    "Editor", "Series Editor", "Translator", "Contributor", "Attorney Agent",
    "Book Author", "Cast Member", "Commenter", "Composer", "Cosponsor",
    "Counsel", "Interviewer", "Producer", "Recipient", "Reviewed Author",
    "Scriptwriter", "Words By", "Guest", "Number", "Edition", "Running Time",
    "Scale", "Medium", "Artwork Size", "Filing Date", "Application Number",
    "Assignee", "Issuing Authority", "Country", "Meeting Name",
    "Conference Name", "Court", "References", "Reporter", "Legal Status",
    "Priority Numbers", "Programming Language", "Version", "System", "Code",
    "Code Number", "Section", "Session", "Committee", "History",
    "Legislative Body"
  ],
  "additionalProperties": false
}