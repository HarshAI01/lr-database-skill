{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/HarshAI01/lr-database-skill/references/extraction-schema.json",
  "title": "LR Database extraction payload",
  "description": "Strict contract for .tmp_extractions.json. The file is an array of extraction records. Every metadata key and every LR matrix key is required. Serial numbers are assigned by assemble and must not be supplied.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/extraction" },
  "definitions": {
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "metadata", "lrMatrix"],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$",
          "description": "Exact basename of a keeper PDF in Incoming/."
        },
        "metadata": { "$ref": "#/definitions/metadata" },
        "lrMatrix": { "$ref": "#/definitions/lrMatrix" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "File Name", "Item Type", "Publication Year", "Author", "Title",
        "Publication Title", "ISBN", "ISSN", "DOI", "Url", "Abstract Note",
        "Date", "Date Added", "Date Modified", "Access Date", "Pages",
        "Num Pages", "Issue", "Volume", "Number Of Volumes",
        "Journal Abbreviation", "Short Title", "Series", "Series Number",
        "Series Text", "Series Title", "Publisher", "Place", "Language",
        "Rights", "Type", "Archive", "Archive Location", "Library Catalog",
        "Call Number", "Extra", "Notes", "File Attachments",
        "Link Attachments", "Manual Tags", "Automatic Tags", "Editor",
        "Series Editor", "Translator", "Contributor", "Attorney Agent",
        "Book Author", "Cast Member", "Commenter", "Composer", "Cosponsor",
        "Counsel", "Interviewer", "Producer", "Recipient", "Reviewed Author",
        "Scriptwriter", "Words By", "Guest", "Number", "Edition",
        "Running Time", "Scale", "Medium", "Artwork Size", "Filing Date",
        "Application Number", "Assignee", "Issuing Authority", "Country",
        "Meeting Name", "Conference Name", "Court", "References", "Reporter",
        "Legal Status", "Priority Numbers", "Programming Language", "Version",
        "System", "Code", "Code Number", "Section", "Session", "Committee",
        "History", "Legislative Body"
      ],
      "properties": {
        "File Name": { "type": "string", "minLength": 1 },
        "Item Type": {
          "type": "string",
          "enum": ["journalArticle", "report", "preprint", "conferencePaper", "thesis"]
        },
        "Publication Year": { "type": "string" },
        "Author": { "type": "string" },
        "Title": { "type": "string", "minLength": 1 },
        "Publication Title": { "type": "string" },
        "ISBN": { "type": "string" },
        "ISSN": { "type": "string" },
        "DOI": {
          "type": "string",
          "pattern": "^(|10\\.\\S+)$",
          "description": "Bare DOI beginning with 10. Empty string when absent."
        },
        "Url": { "type": "string" },
        "Abstract Note": { "type": "string" },
        "Date": { "type": "string" },
        "Date Added": { "type": "string" },
        "Date Modified": { "type": "string" },
        "Access Date": { "type": "string" },
        "Pages": { "type": "string" },
        "Num Pages": { "type": "integer", "minimum": 0 },
        "Issue": { "type": "string" },
        "Volume": { "type": "string" },
        "Number Of Volumes": { "type": "integer", "minimum": 1 },
        "Journal Abbreviation": { "type": "string" },
        "Short Title": { "type": "string" },
        "Series": { "type": "string" },
        "Series Number": { "type": "string" },
        "Series Text": { "type": "string" },
        "Series Title": { "type": "string" },
        "Publisher": { "type": "string" },
        "Place": { "type": "string" },
        "Language": { "type": "string" },
        "Rights": { "type": "string" },
        "Type": { "type": "string" },
        "Archive": { "type": "string" },
        "Archive Location": { "type": "string" },
        "Library Catalog": { "type": "string" },
        "Call Number": { "type": "string" },
        "Extra": { "type": "string" },
        "Notes": { "type": "string" },
        "File Attachments": { "type": "string" },
        "Link Attachments": { "type": "string" },
        "Manual Tags": { "type": "string" },
        "Automatic Tags": { "type": "string" },
        "Editor": { "type": "string" },
        "Series Editor": { "type": "string" },
        "Translator": { "type": "string" },
        "Contributor": { "type": "string" },
        "Attorney Agent": { "type": "string" },
        "Book Author": { "type": "string" },
        "Cast Member": { "type": "string" },
        "Commenter": { "type": "string" },
        "Composer": { "type": "string" },
        "Cosponsor": { "type": "string" },
        "Counsel": { "type": "string" },
        "Interviewer": { "type": "string" },
        "Producer": { "type": "string" },
        "Recipient": { "type": "string" },
        "Reviewed Author": { "type": "string" },
        "Scriptwriter": { "type": "string" },
        "Words By": { "type": "string" },
        "Guest": { "type": "string" },
        "Number": { "type": "string" },
        "Edition": { "type": "string" },
        "Running Time": { "type": "string" },
        "Scale": { "type": "string" },
        "Medium": { "type": "string" },
        "Artwork Size": { "type": "string" },
        "Filing Date": { "type": "string" },
        "Application Number": { "type": "string" },
        "Assignee": { "type": "string" },
        "Issuing Authority": { "type": "string" },
        "Country": { "type": "string" },
        "Meeting Name": { "type": "string" },
        "Conference Name": { "type": "string" },
        "Court": { "type": "string" },
        "References": { "type": "string" },
        "Reporter": { "type": "string" },
        "Legal Status": { "type": "string" },
        "Priority Numbers": { "type": "string" },
        "Programming Language": { "type": "string" },
        "Version": { "type": "string" },
        "System": { "type": "string" },
        "Code": { "type": "string" },
        "Code Number": { "type": "string" },
        "Section": { "type": "string" },
        "Session": { "type": "string" },
        "Committee": { "type": "string" },
        "History": { "type": "string" },
        "Legislative Body": { "type": "string" }
      }
    },
    "lrMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "File Name", "Title", "Author", "Year", "Journal", "DOI",
        "Objective", "Methodology", "Key Finding", "Discussion", "Limitation",
        "Theoretical Framework", "Tag 1 (Method)", "Tag 2 (Type of Research)",
        "Independent Variable", "Dependent Variable", "Other Variable",
        "Decision (For Me)", "Reason (For Me)"
      ],
      "properties": {
        "S. No.": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional and ignored. Assemble assigns continuous serial numbers."
        },
        "File Name": { "type": "string", "minLength": 1 },
        "Title": { "type": "string", "minLength": 1 },
        "Author": { "type": "string" },
        "Year": { "type": "string" },
        "Journal": { "type": "string" },
        "DOI": {
          "type": "string",
          "pattern": "^(|https://doi\\.org/10\\.\\S+)$",
          "description": "Full https://doi.org/... link, or empty string."
        },
        "Objective": { "type": "string" },
        "Methodology": { "type": "string" },
        "Key Finding": { "type": "string" },
        "Discussion": { "type": "string" },
        "Limitation": { "type": "string" },
        "Theoretical Framework": { "type": "string" },
        "Tag 1 (Method)": { "type": "string" },
        "Tag 2 (Type of Research)": {
          "type": "string",
          "enum": ["Quantitative", "Qualitative", "Mixed", "Review-Theoretical", "Reference"]
        },
        "Independent Variable": { "type": "string" },
        "Dependent Variable": { "type": "string" },
        "Other Variable": { "type": "string" },
        "Decision (For Me)": {
          "type": "string",
          "enum": ["", "Include", "Exclude"]
        },
        "Reason (For Me)": { "type": "string" }
      }
    }
  }
}
